// This is your Prisma schema file
// Learn more at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum SubscriptionTier {
  FREE
  PLUS
  PRO
}

enum Role {
  SEEKER
  MENTOR
  ADMIN
}

enum MatchStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  DECLINED
}

enum EventStatus {
  GOING_THROUGH
  SURVIVED
  BOTH
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum MessageType {
  TEXT
  SYSTEM
}

enum LeadStatus {
  NEW
  QUALIFIED
  NOT_READY
  CONTACTED
  CONVERTED
}

enum RoleChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// ──────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  avatar         String?
  role           Role     @default(SEEKER)
  bio            String?
  location       String?
  languages      String[]
  settings       Json     @default("{}")
  deletedAt      DateTime?
  isVerified     Boolean  @default(false)
  isBanned       Boolean  @default(false)
  emailConfirmed Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  stripeCustomerId String? @unique
  tokensUsed       Int      @default(0)
  tokenPeriodStart DateTime @default(now())

  subscriptionTier SubscriptionTier @default(FREE)

  // MFA — mandatory for ADMIN role (enforced in admin-session.controller.ts).
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String? // base32 TOTP secret; only set once, cleared on disable
  mfaBackupCodes String[]  @default([]) // bcrypt hashes, single-use
  mfaEnrolledAt  DateTime?

  mentorProfile   MentorProfile?
  userLifeEvents  UserLifeEvent[]
  seekerMatches   Match[]         @relation("SeekerMatches")
  mentorMatches   Match[]         @relation("MentorMatches")
  sentMessages    Message[]       @relation("SentMessages")
  reportsFiled    Report[]        @relation("Reporter")
  reportsReceived Report[]        @relation("Reported")
  refreshTokens   RefreshToken[]
  adminSessions   AdminSession[]
  checkIns          CheckIn[]
  convertedFromLead MentorLead?
  seekerProfile     SeekerProfile?
  weeklySynthesis   WeeklySynthesis[]
  progressSnapshots ProgressSnapshot[]

  roleChangesRequested RoleChangeRequest[] @relation("RoleChangeRequestedBy")
  roleChangesApproved  RoleChangeRequest[] @relation("RoleChangeApprovedBy")
  roleChangesTargeting RoleChangeRequest[] @relation("RoleChangeTarget")
  impersonationsAsAdmin  ImpersonationSession[] @relation("ImpersonationAdmin")
  impersonationsAsTarget ImpersonationSession[] @relation("ImpersonationTarget")
}

model MentorProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagline         String
  yearsExperience Int     @default(0)
  isAvailable     Boolean @default(true)
  rating          Float   @default(0)
  reviewCount     Int     @default(0)
  maxSeekers      Int     @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LifeEvent {
  id          String @id @default(cuid())
  slug        String @unique
  label       String
  emoji       String
  category    String
  description String

  userLifeEvents UserLifeEvent[]
}

model UserLifeEvent {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeEventId String
  lifeEvent   LifeEvent   @relation(fields: [lifeEventId], references: [id])
  status      EventStatus @default(GOING_THROUGH)
  startDate   DateTime?
  notes       String?

  createdAt DateTime @default(now())

  @@unique([userId, lifeEventId])
}

model Match {
  id           String      @id @default(cuid())
  seekerId     String
  seeker       User        @relation("SeekerMatches", fields: [seekerId], references: [id])
  mentorId     String
  mentor       User        @relation("MentorMatches", fields: [mentorId], references: [id])
  lifeEventId  String?
  matchScore   Int         @default(0)
  status       MatchStatus @default(PENDING)
  initiatorNote String?

  conversation Conversation?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([seekerId, mentorId])
}

model Conversation {
  id      String @id @default(cuid())
  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  messages           Message[]
  progressSnapshots  ProgressSnapshot[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  type           MessageType  @default(TEXT)
  readAt         DateTime?

  createdAt DateTime @default(now())
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedId  String
  reported    User         @relation("Reported", fields: [reportedId], references: [id])
  reason      String
  details     String?
  status      ReportStatus @default(OPEN)
  reviewNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  family    String   @default(cuid()) // token-rotation family for reuse detection
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([family])
}

// Server-side admin console sessions. The browser holds only an opaque random
// token; its SHA-256 hash is stored here. Deleting a row (or setting revokedAt)
// kills the session immediately — real server-side revocation.
model AdminSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // SHA-256 of the opaque session token
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────
// Security / Compliance Models
// ──────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  // plain string — logs survive user deletion
  action     String
  resource   String?
  resourceId String?
  metadata   Json     @default("{}")
  beforeState Json?   // privileged-action state before the change
  afterState  Json?   // privileged-action state after the change
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// Dual-control role changes: an admin proposes, a DIFFERENT admin approves.
// The requester can never approve their own request, and no one can target
// themselves (enforced in the controller, not just here).
model RoleChangeRequest {
  id             String            @id @default(cuid())
  targetUserId   String
  targetUser     User              @relation("RoleChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  currentRole    Role
  requestedRole  Role
  reason         String
  status         RoleChangeStatus  @default(PENDING)
  requestedById  String
  requestedBy    User              @relation("RoleChangeRequestedBy", fields: [requestedById], references: [id])
  approvedById   String?
  approvedBy     User?             @relation("RoleChangeApprovedBy", fields: [approvedById], references: [id])
  decisionNote   String?
  createdAt      DateTime          @default(now())
  decidedAt      DateTime?

  @@index([targetUserId])
  @@index([status])
}

// Time-boxed "log in as user" sessions. The issued JWT carries an
// `impersonating` claim that requireAuth/admin middleware always reject —
// an impersonated session can never reach admin routes or start a nested
// impersonation (non-transitive).
model ImpersonationSession {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    User      @relation("ImpersonationAdmin", fields: [adminUserId], references: [id])
  targetUserId String
  targetUser   User      @relation("ImpersonationTarget", fields: [targetUserId], references: [id])
  reason       String
  tokenId      String    @unique // jti of the impersonation JWT
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  endedAt      DateTime?
  createdAt    DateTime  @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([expiresAt])
}

model IdempotencyKey {
  id         String   @id @default(cuid())
  key        String   @unique // "{userId}:{endpoint}:{clientKey}"
  userId     String
  endpoint   String
  response   Json
  statusCode Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────
// Self-Guided Check-In Models (Free/Plus/Pro paywall)
// ──────────────────────────────────────────────

model CheckIn {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  moodScore  Int      // 1 (struggling) – 5 (great)
  note       String?  @db.Text

  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ──────────────────────────────────────────────
// Seeker progress & insights (restored 2026-08-01 after schema drift;
// tables already existed in DB from an earlier migration, model was missing)
// ──────────────────────────────────────────────

model SeekerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags           String[]
  goals          String[]
  preferences    String[]
  urgency        String?
  emotionalState String?
  updatedAt      DateTime @updatedAt
}

model WeeklySynthesis {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  summary     String
  themes      String[]
  moodTrend   String
  voiceScript String?
  generatedAt DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
}

model ProgressSnapshot {
  id                String       @id @default(cuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationCount Int          @default(1)
  totalActionItems  Int          @default(0)
  completedActions  Int          @default(0)
  engagementScore   Float        @default(0.0)
  progressNotes     String
  snapshotDate      DateTime     @default(now())

  @@index([conversationId])
  @@index([userId])
}

// ──────────────────────────────────────────────
// Marketing: mentor recruitment + mentee acquisition
// ──────────────────────────────────────────────

model MentorLead {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  lifeEvent          String
  story              String     @db.Text
  availability       String     @default("")
  score              Int        @default(0)
  status             LeadStatus @default(NEW)
  qualificationNotes String     @default("") @db.Text

  // Set once an admin approves the lead and a real mentor account is created.
  convertedUserId    String?    @unique
  convertedUser      User?      @relation(fields: [convertedUserId], references: [id])

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status, score])
  @@index([lifeEvent])
  @@map("mentor_leads")
}

model Mentee {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  lifeEvent String
  story     String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lifeEvent])
  @@map("mentees")
}

