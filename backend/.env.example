# Backend Environment Template
# Copy this file to .env and fill in your values

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/myalongside

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ──────────────────────────────────────────────
# CORS Configuration
# ──────────────────────────────────────────────
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ──────────────────────────────────────────────
# Authentication (JWT)
# ──────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# ──────────────────────────────────────────────
# Admin moderation proxy access
ADMIN_SERVICE_TOKEN=generate-a-long-random-secret-for-admin-only-proxying

# ──────────────────────────────────────────────
# Email Configuration (Optional)
# ──────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ──────────────────────────────────────────────
# Marketing: mentor-lead qualification (Claude)
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
# CLAUDE_MODEL=claude-sonnet-4-6

# ──────────────────────────────────────────────
# Marketing: AI Graphic Designer ad-image generation
# ──────────────────────────────────────────────
# IMAGE_PROVIDER=openai              # openai | google
# OPENAI_API_KEY=sk-replace-with-your-key
# GOOGLE_API_KEY=replace-with-your-key

# ──────────────────────────────────────────────
# Marketing: CAPTCHA (Cloudflare Turnstile)
# Leave unset to skip CAPTCHA verification in dev.
# ──────────────────────────────────────────────
# TURNSTILE_SECRET_KEY=0xYYYYYYYYYYYYYYYYYY

# ──────────────────────────────────────────────
# Marketing: high-score lead alerts (Resend)
# Leave unset to skip email notifications.
# ──────────────────────────────────────────────
# RESEND_API_KEY=re_replace-with-your-key
# NOTIFY_FROM=MyAlongside <team@myalongside.com>
# NOTIFY_TO=reviewer1@myalongside.com,reviewer2@myalongside.com
# NOTIFY_SCORE_THRESHOLD=75
