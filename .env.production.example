# Production variables for Vercel (web + admin)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/myalongside_prod?sslmode=require&channel_binding=require
NEXT_PUBLIC_API_BASE=https://api.myalongside.com
WEB_URL=https://myalongside.com
ADMIN_URL=https://admin.myalongside.com

# Admin app (apps/admin) — server-side calls to the backend (login, session
# checks, MFA, proxying). Without this it falls back to http://localhost:4000,
# which is unreachable from Vercel and breaks admin login.
BACKEND_URL=https://api.myalongside.com
