# Quick local setup (development only)
# For production, use .env.production.example

NODE_ENV=development

# Backend
PORT=4000
# Used to build the OAuth redirect_uri sent to Google/Facebook — must exactly
# match what's registered in each provider's console.
API_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://neon_user:password@localhost:5432/myalongside_local
JWT_SECRET=dev-secret-min-32-chars-change-before-deploy-dev-secret
JWT_REFRESH_SECRET=dev-refresh-min-32-chars-change-before-deploy-refresh

# Stripe (use test-mode keys locally)
STRIPE_SECRET_KEY=sk_test_replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-stripe-webhook-secret
STRIPE_PRICE_LIVE_EVENT=price_replace-with-live-event-5_99-price-id

# Google/Facebook OAuth — leave unset to keep those sign-in buttons disabled.
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {API_BASE_URL}/api/auth/google/callback
# Facebook: https://developers.facebook.com/apps
#   Valid OAuth Redirect URI: {API_BASE_URL}/api/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Frontend
# NOTE: no trailing /api — every API call already appends its own /api/... path.
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_STRIPE_PRICE_LIVE_EVENT=price_replace-with-live-event-5_99-price-id

# Workspace URLs
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Optional Neon helper URL (used by scripts/neon-switch.js)
NEON_DATABASE_URL_LOCAL=postgresql://USER:PASSWORD@LOCAL_HOST:5432/myalongside_local?sslmode=require
