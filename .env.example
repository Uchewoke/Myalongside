# Shared
NODE_ENV=development

# Backend
PORT=4000
# Backend's own externally-reachable base URL — used to build the OAuth
# redirect_uri sent to Google/Facebook. Must exactly match what's registered
# in each provider's console (down to trailing slashes).
API_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/myalongside
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-second-long-random-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-stripe-webhook-secret
STRIPE_PRICE_PLUS=price_replace-with-plus-price-id
STRIPE_PRICE_PRO=price_replace-with-pro-price-id

# Google/Facebook OAuth — leave unset to keep those sign-in buttons disabled.
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {API_BASE_URL}/api/auth/google/callback
# Facebook: https://developers.facebook.com/apps
#   Valid OAuth Redirect URI: {API_BASE_URL}/api/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Frontend
# NOTE: no trailing /api — every API call already appends its own /api/... path.
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_STRIPE_PRICE_PLUS=price_replace-with-plus-price-id
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_replace-with-pro-price-id

# Workspace URLs
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Production domains (update for MyAlongside production)
# WEB_URL=https://myalongside.com
# ADMIN_URL=https://admin.myalongside.com
# API_BASE_URL=https://api.myalongside.com
# NEXT_PUBLIC_API_BASE=https://api.myalongside.com
